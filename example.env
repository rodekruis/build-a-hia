# Generate a key with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "local" keeps sessions, files and jobs in HIA_LOCAL_STORAGE_DIR (development only).
# "azure" uses Azure Storage tables, blobs and queues.
HIA_STORAGE_BACKEND=local
HIA_LOCAL_STORAGE_DIR=.hia-storage

# Azure Storage (only when HIA_STORAGE_BACKEND=azure).
AZURE_STORAGE_ACCOUNT_NAME=
# Optional locally; leave empty in Azure, where managed identity is used.
# Without a key, local runs authenticate with your `az login` account.
AZURE_STORAGE_ACCOUNT_KEY=
# Only for local emulators such as Azurite.
# AZURE_STORAGE_CONNECTION_STRING=
# HIA_BLOB_CONTAINER=hia-temp
# HIA_TABLE_NAME=hiaworkflow
# HIA_CONVERT_QUEUE=hia-convert
# HIA_GENERATE_QUEUE=hia-generate

# Azure AI Foundry model deployment (used from step 4, structure proposal).
# Endpoint example: https://<resource>.services.ai.azure.com/
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
# Optional locally; leave empty in Azure, where managed identity is used.
FOUNDRY_API_KEY=
# HIA_MODEL_TIMEOUT_SECONDS=600
# HIA_MODEL_MAX_OUTPUT_TOKENS=16000
# HIA_MAX_SESSION_MODEL_TOKENS=5000000

# Optional limits (defaults shown).
# HIA_SESSION_IDLE_SECONDS=7200
# HIA_SESSION_MAX_SECONDS=86400
# HIA_MAX_FILE_BYTES=26214400
# HIA_MAX_SESSION_BYTES=209715200
# HIA_MAX_REQUEST_BYTES=115343360
# HIA_MAX_SOURCES=25
# HIA_MAX_DOCUMENT_PAGES=300
# HIA_MAX_SESSION_PAGES=1000
# HIA_MAX_SESSION_SOURCE_TOKENS=300000
# HIA_MAX_URL_BYTES=20971520
# HIA_MAX_REDIRECTS=5
# HIA_URL_TIMEOUT_SECONDS=20
# Must exceed each job's replica timeout.
# HIA_JOB_VISIBILITY_SECONDS=14400
# HIA_MAX_JOB_ATTEMPTS=3